# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="robbyrussell"

plugins=(git rust)

if [ -r "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
fi

if [ -r "$HOME/.config/dev-env/env.sh" ]; then
  source "$HOME/.config/dev-env/env.sh"
elif [ -r "$DEV_ENV_HOME/etc/env.sh" ]; then
  source "$DEV_ENV_HOME/etc/env.sh"
fi

alias nv=nvim

# Preferred editor for local and remote sessions.
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

# Source local tool environments when they exist.
if [ -r "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi

if [ -r "$HOME/.local/bin/env" ]; then
  . "$HOME/.local/bin/env"
fi

if [ -r "$HOME/.local/share/bob/env/env.sh" ]; then
  . "$HOME/.local/share/bob/env/env.sh"
fi

{{- if eq .chezmoi.os "darwin" }}
export PATH="/Library/Tex/texbin:$PATH"

# macOS-only local workstation integrations.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if command -v limactl >/dev/null 2>&1; then
  eval "$(limactl completion zsh)"
fi

if command -v colima >/dev/null 2>&1; then
  eval "$(colima completion zsh)"
fi
{{- end }}

if command -v rustup >/dev/null 2>&1; then
  eval "$(rustup completions zsh)"
fi

if command -v uv >/dev/null 2>&1; then
  eval "$(uv generate-shell-completion zsh)"
fi

if command -v uvx >/dev/null 2>&1; then
  eval "$(uvx --generate-shell-completion zsh)"
fi

if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm completions --shell zsh)"
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}
