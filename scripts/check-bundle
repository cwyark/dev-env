#!/usr/bin/env sh

set -eu

usage() {
  cat <<'EOF'
Usage: check-bundle <archive.tar.gz>

Unpack a dev-env bundle into a temporary prefix and run basic smoke tests.
EOF
}

archive="${1:-}"
if [ -z "$archive" ] || [ "$archive" = "-h" ] || [ "$archive" = "--help" ]; then
  usage
  exit 0
fi

if [ ! -f "$archive" ]; then
  printf 'check-bundle: archive not found: %s\n' "$archive" >&2
  exit 1
fi

tmp="${TMPDIR:-/tmp}/dev-env.check.$$"
cleanup() {
  chmod -R u+rwX "$tmp" 2>/dev/null || true
  rm -rf "$tmp"
}
trap cleanup EXIT HUP INT TERM

rm -rf "$tmp"
mkdir -p "$tmp"
tar -xzf "$archive" -C "$tmp"

DEV_ENV_HOME="$tmp"
export DEV_ENV_HOME
PATH="$DEV_ENV_HOME/bin:$PATH"
export PATH

require_path() {
  path="$1"
  if [ ! -e "$DEV_ENV_HOME/$path" ]; then
    printf 'check-bundle: missing expected path: %s\n' "$path" >&2
    exit 1
  fi
}

run_check() {
  name="$1"
  shift
  printf 'check-bundle: %-18s' "$name"
  if "$@" >/dev/null 2>&1; then
    printf 'ok\n'
  else
    printf 'failed\n' >&2
    printf 'check-bundle: command failed:' >&2
    printf ' %s' "$@" >&2
    printf '\n' >&2
    exit 1
  fi
}

require_path bin/dev-env
require_path lib/platform.sh
require_path scripts
require_path chezmoi
require_path etc/fish/config.fish
require_path share/dev-env/source/bin
require_path share/dev-env/source/lib
require_path share/dev-env/source/scripts
require_path share/dev-env/source/chezmoi
require_path share/dev-env/source/runtime
require_path share/dev-env/reports/nix-store-references.txt
require_path share/dev-env/reports/file-types.txt

run_check dev-env-help "$DEV_ENV_HOME/bin/dev-env" --help
run_check dev-env-version "$DEV_ENV_HOME/bin/dev-env" version
run_check dev-env-platform "$DEV_ENV_HOME/bin/dev-env" platform
run_check fish-version "$DEV_ENV_HOME/bin/fish" --version
run_check nvim-version "$DEV_ENV_HOME/bin/nvim" --version
run_check git-version "$DEV_ENV_HOME/bin/git" --version
run_check yazi-version "$DEV_ENV_HOME/bin/yazi" --version
run_check zellij-version "$DEV_ENV_HOME/bin/zellij" --version

if [ -s "$DEV_ENV_HOME/share/dev-env/reports/nix-store-references.txt" ]; then
  printf 'check-bundle: warning: /nix/store references were recorded in share/dev-env/reports/nix-store-references.txt\n' >&2
fi

printf 'check-bundle: ok: %s\n' "$archive"
