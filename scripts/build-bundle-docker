#!/usr/bin/env sh

set -eu

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$repo_root"

# Requires Colima running with containerd and amd64 emulation enabled.
# See README.md for the exact startup command.
colima nerdctl -- build \
  --platform=linux/amd64 \
  --target bundle \
  --output type=local,dest=dist \
  -f docker/Dockerfile.bundle-builder \
  .
