#!/usr/bin/env sh

set -eu

SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SELF_DIR/.." && pwd)"

# shellcheck source=../lib/platform.sh
. "$REPO_ROOT/lib/platform.sh"

DEV_ENV_HOME="${DEV_ENV_HOME:-$HOME/.local/share/dev-env}"
export DEV_ENV_HOME
export PATH="$DEV_ENV_HOME/bin:$PATH"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$DEV_ENV_HOME/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$DEV_ENV_HOME/cache}"

usage() {
  cat <<'EOF'
Usage: dev-env <command>

Commands:
  version        Print dev-env version
  doctor         Check expected tools
  platform       Print detected platform
  shell          Start an activated shell
  zellij         Start zellij in the activated environment
  nvim [args...] Start neovim in the activated environment
  yazi [args...] Start yazi in the activated environment
  chezmoi-apply  Apply chezmoi source from this repo
EOF
}

doctor() {
  missing=0
  for cmd in nvim yazi zellij chezmoi git rg fd fzf fnm lazygit uv; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf 'ok      %s -> %s\n' "$cmd" "$(command -v "$cmd")"
    else
      printf 'missing %s\n' "$cmd"
      missing=1
    fi
  done
  return "$missing"
}

version() {
  version_file="$REPO_ROOT/VERSION"

  if [ -d "$REPO_ROOT/.git" ] && command -v git >/dev/null 2>&1; then
    hash="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || true)"
    if [ -n "$hash" ]; then
      if ! git -C "$REPO_ROOT" diff --quiet --ignore-submodules HEAD -- 2>/dev/null; then
        hash="$hash-dirty"
      fi
      printf 'dev-env %s\n' "$hash"
      return 0
    fi
  fi

  if [ -r "$version_file" ]; then
    printf 'dev-env %s\n' "$(sed -n '1p' "$version_file")"
    return 0
  fi

  printf 'dev-env unknown\n'
}

cmd="${1:-}"
case "$cmd" in
  version|--version|-V)
    version
    ;;
  doctor)
    doctor
    ;;
  platform)
    dev_env_platform
    ;;
  shell)
    cd "${DEV_ENV_WORKDIR:-$PWD}"
    shell="${SHELL:-/bin/sh}"
    if [ "${DEV_ENV_QUIET:-0}" != "1" ]; then
      printf 'dev-env: entered shell (%s)\n' "$(dev_env_platform)"
    fi
    set +e
    "$shell" -l
    status=$?
    set -e
    if [ "${DEV_ENV_QUIET:-0}" != "1" ]; then
      printf 'dev-env: exited shell (%s, status %s)\n' "$(dev_env_platform)" "$status"
    fi
    exit "$status"
    ;;
  zellij)
    exec zellij
    ;;
  nvim)
    shift
    exec nvim "$@"
    ;;
  yazi)
    shift
    exec yazi "$@"
    ;;
  chezmoi-apply)
    exec chezmoi --source "$REPO_ROOT/chezmoi" apply
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    printf 'unknown command: %s\n\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac
