#!/usr/bin/env sh

set -eu

SELF="$0"
while [ -L "$SELF" ]; do
  dir="$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)"
  link="$(readlink "$SELF")"
  case "$link" in
    /*) SELF="$link" ;;
    *) SELF="$dir/$link" ;;
  esac
done

SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SELF_DIR/.." && pwd)"

# shellcheck source=../lib/platform.sh
. "$REPO_ROOT/lib/platform.sh"
# shellcheck source=../lib/ssh.sh
. "$REPO_ROOT/lib/ssh.sh"
# shellcheck source=../lib/node-tools.sh
. "$REPO_ROOT/lib/node-tools.sh"
# shellcheck source=../lib/bun-tools.sh
. "$REPO_ROOT/lib/bun-tools.sh"

DEV_ENV_HOME="${DEV_ENV_HOME:-$HOME/.local/share/dev-env}"
export DEV_ENV_HOME
DEV_ENV_ROOT="${DEV_ENV_ROOT:-$REPO_ROOT}"
export DEV_ENV_ROOT
if [ -d "$DEV_ENV_ROOT/etc" ]; then
  DEV_ENV_ETC="${DEV_ENV_ETC:-$DEV_ENV_ROOT/etc}"
else
  DEV_ENV_ETC="${DEV_ENV_ETC:-$DEV_ENV_ROOT/share/dev-env/etc}"
fi
export DEV_ENV_ETC
export PATH="$DEV_ENV_ROOT/bin:$DEV_ENV_HOME/bin:$PATH"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$DEV_ENV_HOME/config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$DEV_ENV_HOME/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$DEV_ENV_HOME/cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$DEV_ENV_HOME/state}"

dev_env_activate() {
  mkdir -p \
    "$XDG_CONFIG_HOME" \
    "$XDG_DATA_HOME" \
    "$XDG_CACHE_HOME" \
    "$XDG_STATE_HOME"
}

dev_env_activate_node() {
  if ! dev_env_use_fnm_node; then
    node_version_file="$(dev_env_node_version_file || true)"
    if [ -n "$node_version_file" ]; then
      node_version="$(sed -n '1p' "$node_version_file")"
      if [ -n "$node_version" ]; then
        printf 'dev-env: fnm node %s unavailable, using Nix fallback\n' "$node_version" >&2
      fi
    fi
  fi
}

dev_env_activate_bun_tools() {
  dev_env_activate_bun
  dev_env_ensure_bun_tools || true
}

usage() {
  cat <<'EOF'
Usage: dev-env <command>

Commands:
  version        Print dev-env version
  doctor         Check expected tools
  platform       Print detected platform
  shell          Start the isolated fish shell
  zellij         Start zellij in the activated environment
  zellij [session]
                 Attach to a zellij session, creating it if needed
  btop           Start btop in the activated environment
  nvim [args...] Start neovim in the activated environment
  yazi [args...] Start yazi in the activated environment
  chezmoi-apply  Apply host dotfiles from chezmoi source
EOF
}

doctor() {
  missing=0
  for cmd in fish nvim yazi zellij btop chezmoi git rg fd fzf fnm bun node opencode tree-sitter lazygit eza uv carapace zig zls; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf 'ok      %s -> %s\n' "$cmd" "$(command -v "$cmd")"
    else
      printf 'missing %s\n' "$cmd"
      missing=1
    fi
  done
  return "$missing"
}

version() {
  version_file="$REPO_ROOT/VERSION"

  if [ -d "$REPO_ROOT/.git" ] && command -v git >/dev/null 2>&1; then
    hash="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || true)"
    if [ -n "$hash" ]; then
      if ! git -C "$REPO_ROOT" diff --quiet --ignore-submodules HEAD -- 2>/dev/null; then
        hash="$hash-dirty"
      fi
      printf 'dev-env %s\n' "$hash"
      return 0
    fi
  fi

  if [ -r "$version_file" ]; then
    printf 'dev-env %s\n' "$(sed -n '1p' "$version_file")"
    return 0
  fi

  printf 'dev-env unknown\n'
}

cmd="${1:-}"
dev_env_activate
dev_env_activate_node
dev_env_activate_bun_tools
case "$cmd" in
  version|--version|-V)
    version
    ;;
  doctor)
    doctor
    ;;
  platform)
    dev_env_platform
    ;;
  shell)
    cd "${DEV_ENV_WORKDIR:-$PWD}"
    shell="${DEV_ENV_FISH:-}"
    if [ -z "$shell" ]; then
      shell="$(command -v fish 2>/dev/null || true)"
    fi
    if [ -n "$shell" ] && [ ! -x "$shell" ]; then
      shell=""
    fi
    if [ -z "$shell" ]; then
      printf 'dev-env: no usable fish shell found\n' >&2
      exit 1
    fi
    export SHELL="$shell"
    export FISH_INIT_SCRIPT="$DEV_ENV_ETC/fish/config.fish"
    if [ "${DEV_ENV_QUIET:-0}" != "1" ]; then
      printf 'dev-env: entered fish shell (%s)\n' "$(dev_env_platform)"
    fi
    set +e
    "$shell" --login --no-config -C 'source $FISH_INIT_SCRIPT'
    status=$?
    set -e
    if [ "${DEV_ENV_QUIET:-0}" != "1" ]; then
      printf 'dev-env: exited fish shell (%s, status %s)\n' "$(dev_env_platform)" "$status"
    fi
    exit "$status"
    ;;
  zellij)
    shift
    if [ "$#" -gt 1 ]; then
      printf 'dev-env: unexpected argument: %s\n' "$2" >&2
      exit 2
    fi
    session="${1:-}"
    if [ -z "$session" ]; then
      TERM=xterm-256color exec zellij
    fi
    dev_env_validate_session_name "$session"
    shell="${DEV_ENV_FISH:-}"
    if [ -z "$shell" ]; then
      shell="$(command -v fish 2>/dev/null || true)"
    fi
    if [ -n "$shell" ] && [ ! -x "$shell" ]; then
      shell=""
    fi
    if [ -z "$shell" ]; then
      printf 'dev-env: no usable fish shell found\n' >&2
      exit 1
    fi
    export SHELL="$shell"
    export FISH_INIT_SCRIPT="$DEV_ENV_ETC/fish/config.fish"
    TERM=xterm-256color exec "$shell" --login --no-config -C "source \$FISH_INIT_SCRIPT; if zellij attach \"$session\"; else zellij attach --create-background \"$session\" >/dev/null 2>&1; exec zellij attach \"$session\"; end"
    ;;
  btop)
    exec btop
    ;;
  nvim)
    shift
    exec nvim "$@"
    ;;
  yazi)
    shift
    exec yazi "$@"
    ;;
  chezmoi-apply)
    printf 'dev-env: warning: chezmoi-apply writes host dotfiles outside DEV_ENV_HOME\n' >&2
    exec chezmoi --source "$REPO_ROOT/chezmoi" apply
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    printf 'unknown command: %s\n\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac
