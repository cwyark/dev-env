#!/usr/bin/env sh

set -eu

usage() {
  cat <<'EOF'
Usage: dev-clean [ssh-target]

Remove an installed dev-env tree from ~/.local/share/dev-env.
With no ssh-target, clean the local machine.
EOF
}

clean_script='
set -eu
dev_env_home="${DEV_ENV_HOME:-$HOME/.local/share/dev-env}"
case "$dev_env_home" in
  ""|"/"|"$HOME"|"$HOME/"|"$HOME/.local"|"$HOME/.local/share")
    printf "dev-clean: refusing unsafe DEV_ENV_HOME: %s\n" "$dev_env_home" >&2
    exit 1
    ;;
esac
if [ ! -f "$dev_env_home/.dev-env-root" ]; then
  printf "dev-clean: refusing to remove %s: missing .dev-env-root\n" "$dev_env_home" >&2
  exit 1
fi
chmod -R u+rwX "$dev_env_home" 2>/dev/null || true
rm -rf "$dev_env_home"
printf "removed dev-env from %s\n" "$dev_env_home"
'

target=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      printf 'dev-clean: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [ -n "$target" ]; then
        printf 'dev-clean: unexpected argument: %s\n' "$1" >&2
        usage >&2
        exit 2
      fi
      target="$1"
      shift
      ;;
  esac
done

if [ -n "$target" ]; then
  ssh "$target" "$clean_script"
else
  sh -c "$clean_script"
fi
