#!/usr/bin/env sh

set -eu

SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SELF_DIR/.." && pwd)"

# shellcheck source=../lib/platform.sh
. "$REPO_ROOT/lib/platform.sh"
# shellcheck source=../lib/ssh.sh
. "$REPO_ROOT/lib/ssh.sh"
# shellcheck source=../lib/install.sh
. "$REPO_ROOT/lib/install.sh"

usage() {
  cat <<'EOF'
Usage: dev-deploy [ssh-target]

Detect the target platform and install the matching dev-env bundle.
With no ssh-target, install the matching bundle on the local machine.
EOF
}

target=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      printf 'dev-deploy: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [ -n "$target" ]; then
        printf 'dev-deploy: unexpected argument: %s\n' "$1" >&2
        usage >&2
        exit 2
      fi
      target="$1"
      shift
      ;;
  esac
done

if [ -n "$target" ]; then
  platform="$(dev_env_detect_remote_platform "$target")"
else
  platform="$(dev_env_platform)"
fi

if [ -z "$target" ]; then
  bundle="$(dev_env_bundle_path "$REPO_ROOT" "$platform")"
  if [ ! -f "$bundle" ]; then
    printf 'dev-deploy: missing bundle: %s\n' "$bundle" >&2
    printf 'dev-deploy: build it with: scripts/build-bundle %s\n' "$platform" >&2
    exit 1
  fi
  dev_env_install_archive "$bundle"
  exit $?
fi

remote_tmp=""
source_archive=""
cleanup() {
  if [ -n "${remote_tmp:-}" ]; then
    ssh "$target" "rm -rf $(dev_env_sh_quote "$remote_tmp")" >/dev/null 2>&1 || true
  fi
  if [ -n "${source_archive:-}" ] && [ -f "$source_archive" ]; then
    rm -f "$source_archive"
  fi
}
trap cleanup EXIT HUP INT TERM

remote_tmp="$(
  ssh "$target" 'tmp="${TMPDIR:-/tmp}"; if command -v mktemp >/dev/null 2>&1; then mktemp -d "$tmp/dev-env-upload.XXXXXX"; else d="$tmp/dev-env-upload.$$"; mkdir -p "$d"; echo "$d"; fi'
)"

source_archive="$(mktemp "${TMPDIR:-/tmp}/dev-env-source.XXXXXX.tar.gz")"
(
  cd "$REPO_ROOT"
  tar \
    --exclude='./.cache' \
    --exclude='./.cache/*' \
    --exclude='./.git' \
    --exclude='./.git/*' \
    --exclude='./dist' \
    --exclude='./dist/*' \
    --exclude='./result' \
    --exclude='./result-*' \
    -czf "$source_archive" .
)

ssh "$target" "mkdir -p $(dev_env_sh_quote "$remote_tmp/src") $(dev_env_sh_quote "$remote_tmp/lib")"
scp "$source_archive" "$target:$remote_tmp/dev-env-source.tar.gz"
scp "$REPO_ROOT/lib/install.sh" "$target:$remote_tmp/lib/install.sh"
ssh "$target" sh -s -- "$remote_tmp/src" "$remote_tmp/dev-env-source.tar.gz" "$remote_tmp/lib/install.sh" "$platform" <<'EOF'
set -eu

src_dir="$1"
src_archive="$2"
install_script="$3"
platform="$4"

mkdir -p "$src_dir"
tar -xzf "$src_archive" -C "$src_dir"
cd "$src_dir"

nix --extra-experimental-features 'nix-command flakes' build ".#packages.$platform.bundle"
. "$install_script"
dev_env_install_archive "$src_dir/result/dev-env-$platform.tar.gz"
EOF
