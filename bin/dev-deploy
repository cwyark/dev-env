#!/usr/bin/env sh

set -eu

SELF_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH='' cd -- "$SELF_DIR/.." && pwd)"
export PATH="$HOME/.local/share/dev-env/bin:$HOME/.local/bin:$PATH"

# shellcheck source=../lib/platform.sh
. "$REPO_ROOT/lib/platform.sh"
# shellcheck source=../lib/ssh.sh
. "$REPO_ROOT/lib/ssh.sh"

usage() {
  cat <<'EOF'
Usage: dev-deploy [ssh-target]

Install or update the mise-managed dev-env runtime.
With no ssh-target, install on the local machine.
EOF
}

install_mise_local() {
  if command -v mise >/dev/null 2>&1; then
    return 0
  fi

  mkdir -p "$HOME/.local/bin"
  if command -v curl >/dev/null 2>&1; then
    curl https://mise.run | sh
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- https://mise.run | sh
  else
    printf 'dev-deploy: curl or wget is required to install mise\n' >&2
    return 1
  fi

  if ! command -v mise >/dev/null 2>&1; then
    printf 'dev-deploy: mise install completed but mise is not on PATH\n' >&2
    printf 'dev-deploy: expected mise at %s\n' "$HOME/.local/bin/mise" >&2
    return 1
  fi
}

target=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      printf 'dev-deploy: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [ -n "$target" ]; then
        printf 'dev-deploy: unexpected argument: %s\n' "$1" >&2
        usage >&2
        exit 2
      fi
      target="$1"
      shift
      ;;
  esac
done

if [ -z "$target" ]; then
  install_mise_local
  "$REPO_ROOT/bin/dev-env" install
  exit $?
fi

platform="$(dev_env_detect_remote_platform "$target")"
case "$platform" in
  linux-*|wsl-linux-*|macos-*) ;;
  *)
    printf 'dev-deploy: unsupported remote platform: %s\n' "$platform" >&2
    exit 1
    ;;
esac

archive="$(mktemp "${TMPDIR:-/tmp}/dev-env-source.XXXXXX.tar.gz")"
remote_tmp=""
cleanup() {
  rm -f "$archive"
  if [ -n "${remote_tmp:-}" ]; then
    ssh "$target" "rm -rf $(dev_env_sh_quote "$remote_tmp")" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT HUP INT TERM

(
  cd "$REPO_ROOT"
  tar \
    --exclude .git \
    --exclude .cache \
    --exclude dist \
    --exclude result \
    --exclude 'result-*' \
    -czf "$archive" .
)

remote_tmp="$(ssh "$target" 'tmp="${TMPDIR:-/tmp}"; if command -v mktemp >/dev/null 2>&1; then mktemp -d "$tmp/dev-env-upload.XXXXXX"; else d="$tmp/dev-env-upload.$$"; mkdir -p "$d"; echo "$d"; fi')"
scp "$archive" "$target:$remote_tmp/source.tar.gz"

ssh "$target" sh -s <<'EOF'
set -eu

DEV_ENV_HOME="${DEV_ENV_HOME:-$HOME/.local/share/dev-env}"
export DEV_ENV_HOME
export MISE_GLOBAL_CONFIG_FILE="$DEV_ENV_HOME/config/mise/config.toml"
export MISE_DATA_DIR="$DEV_ENV_HOME/share/mise"
export MISE_CACHE_DIR="$DEV_ENV_HOME/cache/mise"
export MISE_STATE_DIR="$DEV_ENV_HOME/state/mise"
export PATH="$DEV_ENV_HOME/bin:$HOME/.local/bin:$PATH"

if ! command -v mise >/dev/null 2>&1; then
  mkdir -p "$HOME/.local/bin"
  if command -v curl >/dev/null 2>&1; then
    curl https://mise.run | sh
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- https://mise.run | sh
  else
    printf 'dev-deploy: remote requires curl or wget to install mise\n' >&2
    exit 1
  fi
fi

if ! command -v mise >/dev/null 2>&1; then
  printf 'dev-deploy: mise install completed but mise is not on PATH\n' >&2
  exit 1
fi
EOF

ssh "$target" sh -s -- "$remote_tmp" <<'EOF'
set -eu

remote_tmp="$1"
DEV_ENV_HOME="${DEV_ENV_HOME:-$HOME/.local/share/dev-env}"
export DEV_ENV_HOME
export MISE_GLOBAL_CONFIG_FILE="$DEV_ENV_HOME/config/mise/config.toml"
export MISE_DATA_DIR="$DEV_ENV_HOME/share/mise"
export MISE_CACHE_DIR="$DEV_ENV_HOME/cache/mise"
export MISE_STATE_DIR="$DEV_ENV_HOME/state/mise"
export PATH="$DEV_ENV_HOME/bin:$HOME/.local/bin:$PATH"

mkdir -p "$DEV_ENV_HOME/source"
rm -rf "$DEV_ENV_HOME/source"
mkdir -p "$DEV_ENV_HOME/source"
tar -xzf "$remote_tmp/source.tar.gz" -C "$DEV_ENV_HOME/source"

"$DEV_ENV_HOME/source/bin/dev-env" install
"$DEV_ENV_HOME/bin/dev-env" doctor
EOF
