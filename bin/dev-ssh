#!/usr/bin/env sh

set -eu

SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SELF_DIR/.." && pwd)"

usage() {
  cat <<'EOF'
Usage: dev-ssh [--session [name]] <ssh-target>

Enter an already-installed remote dev-env shell.
When --session is set, attach to that zellij session on the remote host,
creating it if needed. The default session name is "dev".
EOF
}

session=""
use_session=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -s|--session)
      shift
      use_session=1
      if [ "$#" -gt 1 ]; then
        session="${1:-}"
        shift
      fi
      ;;
    --session=*)
      session="${1#*=}"
      if [ -z "$session" ]; then
        printf 'dev-ssh: missing session name after --session\n' >&2
        exit 2
      fi
      use_session=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      printf 'dev-ssh: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [ "$use_session" -eq 1 ] && [ -z "$session" ]; then
  session="dev"
fi

target="${1:-}"
if [ -z "$target" ] || [ "$target" = "-h" ] || [ "$target" = "--help" ]; then
  usage
  exit 0
fi
shift

if [ "$#" -gt 0 ]; then
  printf 'dev-ssh: unexpected argument: %s\n' "$1" >&2
  usage >&2
  exit 2
fi

# shellcheck source=../lib/ssh.sh
. "$REPO_ROOT/lib/ssh.sh"

if [ "$use_session" -eq 1 ]; then
  dev_env_validate_session_name "$session"
fi

if ! dev_env_remote_has_install "$target"; then
  printf 'dev-ssh: dev-env is not installed on %s\n' "$target" >&2
  printf 'dev-ssh: deploy it first with: bin/dev-deploy %s\n' "$target" >&2
  exit 1
fi

if [ "$use_session" -eq 1 ]; then
  ssh -t "$target" "DEV_ENV_HOME=\"\$HOME/.local/share/dev-env\"; export DEV_ENV_HOME; PATH=\"\$DEV_ENV_HOME/bin:\$PATH\"; export PATH; exec \"\$HOME/.local/share/dev-env/bin/dev-env\" zellij-dev \"$session\""
else
  ssh -t "$target" "exec \"\$HOME/.local/share/dev-env/bin/dev-env\" shell"
fi
