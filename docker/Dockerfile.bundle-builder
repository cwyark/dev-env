# syntax=docker/dockerfile:1.7

ARG ALPINE_IMAGE=alpine:3.22
ARG BUNDLE_SYSTEM=x86_64-linux

FROM --platform=$TARGETPLATFORM ${ALPINE_IMAGE} AS builder

ARG BUNDLE_SYSTEM
ARG DEV_ENV_VERSION=unknown

WORKDIR /workspace

RUN apk add --no-cache \
    bash \
    ca-certificates \
    coreutils \
    git \
    nix \
    tar \
    xz

# Keep the build context small and deterministic.
COPY . .

RUN mkdir -p dist .cache \
  && printf '%s\n' "$DEV_ENV_VERSION" > VERSION \
  && nix --extra-experimental-features 'nix-command flakes' --option sandbox false --option filter-syscalls false build ".#packages.${BUNDLE_SYSTEM}.bundle" \
  && mkdir -p /bundle \
  && cp "result/dev-env-${BUNDLE_SYSTEM}.tar.gz" "/bundle/dev-env-${BUNDLE_SYSTEM}.tar.gz"

FROM scratch AS bundle

COPY --from=builder /bundle/ /
